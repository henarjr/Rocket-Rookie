<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="Score: 0" name="ScoreLabel" style="justify-content: flex-start; align-self: center; align-content: auto; -unity-font-style: bold; font-size: 20px; color: rgb(255, 255, 255); top: 30px; -unity-text-align: middle-center; -unity-text-outline-color: rgb(255, 146, 49); -unity-text-outline-width: 0.5px; border-top-color: rgb(232, 133, 45); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-left-color: rgb(232, 133, 45); border-bottom-color: rgb(232, 133, 45); border-right-color: rgb(232, 133, 45); padding-left: 5px; padding-right: 5px; align-items: auto; -unity-text-auto-size: none; background-color: rgba(232, 133, 45, 0.035);"/>
    <ui:Button text="Restart" name="RestartButton" style="position: absolute; top: 70%; align-self: center; font-size: 20px; -unity-font-style: bold; background-color: rgba(255, 120, 0, 0.765); opacity: 1; color: rgb(0, 0, 0); -unity-background-image-tint-color: rgb(255, 255, 255); border-top-left-radius: 5px; border-bottom-left-radius: 5px; border-left-width: 1px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-top-color: rgb(255, 255, 255); border-left-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255);"/>
    <ui:Label text="High Score: 0" name="HighScoreLabel" style="justify-content: flex-start; align-self: center; align-content: auto; -unity-font-style: bold; font-size: 20px; color: rgb(255, 255, 255); top: 30px; -unity-text-align: middle-center; -unity-text-outline-color: rgb(255, 146, 49); -unity-text-outline-width: 0.5px; border-top-color: rgb(232, 133, 45); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-left-color: rgb(232, 133, 45); border-bottom-color: rgb(232, 133, 45); border-right-color: rgb(232, 133, 45); padding-left: 5px; padding-right: 5px; align-items: auto; -unity-text-auto-size: none; background-color: rgba(183, 92, 11, 0.718);"/>
    <ui:Label text="Game Over" name="GameOverLabel" style="justify-content: flex-start; align-self: center; align-content: auto; -unity-font-style: bold; font-size: 30px; color: rgb(255, 255, 255); top: 50px; -unity-text-align: middle-center; -unity-text-outline-color: rgb(255, 146, 49); -unity-text-outline-width: 0.5px; border-top-color: rgb(232, 133, 45); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; border-left-color: rgb(232, 133, 45); border-bottom-color: rgb(232, 133, 45); border-right-color: rgb(232, 133, 45); padding-left: 5px; padding-right: 5px; align-items: auto; -unity-text-auto-size: none; background-color: rgba(183, 92, 11, 0);"/>
</ui:UXML>
